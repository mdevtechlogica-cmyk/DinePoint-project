# Copy to apps/api/.env for local API and Prisma commands.
# Prisma loads that file from the API package.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dinepoint?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/dinepoint?sslmode=require"

PORT=3000
NODE_ENV=development

JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_DAYS="30"
# Set true only in local/dev to return reset tokens in API responses
EXPOSE_PASSWORD_RESET_TOKEN="false"
PASSWORD_RESET_APP_URL="dinepoint://reset-password"

# Optional SMTP for password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Twilio for server-side SMS / WhatsApp (otherwise Host Stand opens device apps)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Firebase Admin for FCM push (optional). Use one of:
# 1) Inline service-account JSON (single line):
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2) Or path to the downloaded service-account file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
