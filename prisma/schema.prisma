generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  SEATED
  COMPLETED
  NO_SHOW
}

enum SeatingPreference {
  ANY
  FAMILY
  NON_FAMILY
}

enum CoolingPreference {
  ANY
  AC
  NON_AC
}

enum ReservationSource {
  PUBLIC_WEB
  CUSTOMER_APP
  ADMIN_APP
  PHONE
  WALK_IN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
}

enum SubscriptionEventAction {
  CREATED
  PLAN_CHANGED
  STATUS_CHANGED
  PERIOD_UPDATED
  TRIAL_EXTENDED
  CANCELLED
}

enum InvoiceStatus {
  DUE
  PAID
  VOID
}

enum MessageChannel {
  SMS
  WHATSAPP
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  phone         String?
  status        UserStatus     @default(ACTIVE)
  platformRole  PlatformRole?
  notifications Notification[]
  deviceTokens  DeviceToken[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  outboundMessages OutboundMessage[] @relation("OutboundMessageCreatedBy")

  memberships OrganizationMember[]
  createdReservations Reservation[] @relation("ReservationCreatedBy")
  subscriptionEvents SubscriptionEvent[]
  invoicesCreated Invoice[] @relation("InvoiceCreatedBy")
  platformAuditLogs PlatformAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([platformRole])
}

model Organization {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  memberships  OrganizationMember[]
  branches     Branch[]
  subscription Subscription?
  invoices     Invoice[]
  apiKeys      ApiKey[]
  outboundMessages OutboundMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(STAFF)
  isActive       Boolean          @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Branch {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String  @default("India")
  postalCode     String?
  phone          String?
  timezone       String  @default("Asia/Kolkata")
  isActive       Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, isActive])
}

model Restaurant {
  id            String  @id @default(cuid())
  branchId      String  @unique
  name          String
  slug          String  @unique
  description   String?
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  area          String?
  city          String?
  state         String?
  country       String  @default("India")
  postalCode    String?
  logoUrl       String?
  coverImageUrl String?
  isPublished   Boolean @default(false)
  isActive      Boolean @default(true)

  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openingHours OpeningHour[]
  floors       Floor[]
  tables       RestaurantTable[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, isPublished, isActive])
}

model OpeningHour {
  id           String  @id @default(cuid())
  restaurantId String
  dayOfWeek    Int
  openTime     String?
  closeTime    String?
  isClosed     Boolean @default(false)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, dayOfWeek])
}

model Floor {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rooms      Room[]
  tables     RestaurantTable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
}

model Room {
  id       String  @id @default(cuid())
  floorId  String
  name     String
  isActive Boolean @default(true)

  floor  Floor             @relation(fields: [floorId], references: [id], onDelete: Cascade)
  tables RestaurantTable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([floorId, name])
  @@index([floorId, isActive])
}

model RestaurantTable {
  id               String  @id @default(cuid())
  restaurantId     String
  floorId          String
  roomId           String
  floorNumber      Int     @default(1)
  roomName         String?
  tableNumber      Int
  seats            Int
  isAc             Boolean @default(false)
  isFamilyFriendly Boolean @default(false)
  isActive         Boolean @default(true)

  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  floor        Floor              @relation(fields: [floorId], references: [id], onDelete: Restrict)
  room         Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reservations ReservationTable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, tableNumber])
  @@index([restaurantId, isActive])
  @@index([floorId])
  @@index([roomId])
}

model Customer {
  id            String  @id @default(cuid())
  name          String?
  phone         String
  email         String?
  phoneVerified Boolean @default(false)

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([email])
}

model Reservation {
  id          String @id @default(cuid())
  bookingCode String @unique

  restaurantId String
  customerId   String?

  guestName  String
  guestPhone String
  guestEmail String?

  startsAt   DateTime
  endsAt     DateTime
  guestCount Int

  seatingPreference SeatingPreference @default(ANY)
  coolingPreference CoolingPreference @default(ANY)

  status          ReservationStatus @default(PENDING)
  source          ReservationSource @default(PUBLIC_WEB)
  specialRequests String?
  createdByUserId String?

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  tables     ReservationTable[]
  events     ReservationEvent[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@index([restaurantId, startsAt, status])
  @@index([customerId, startsAt])
  @@index([guestPhone, startsAt])
  @@index([createdByUserId])
}

model ReservationTable {
  reservationId String
  tableId       String

  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@id([reservationId, tableId])
  @@index([tableId])
}

model ReservationEvent {
  id            String  @id @default(cuid())
  reservationId String
  eventType     String
  description   String?
  actorUserId   String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reservationId, createdAt])
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  monthlyPrice Decimal  @db.Decimal(10, 2)
  annualPrice  Decimal? @db.Decimal(10, 2)
  currency     String   @default("INR")
  isActive     Boolean  @default(true)

  subscriptions Subscription[]
  entitlements  PlanEntitlement[]
  eventsFrom    SubscriptionEvent[] @relation("SubscriptionEventFromPlan")
  eventsTo      SubscriptionEvent[] @relation("SubscriptionEventToPlan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanEntitlement {
  id     String @id @default(cuid())
  planId String
  key    String
  value  Json

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, key])
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  planId         String
  status         SubscriptionStatus @default(TRIALING)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelledAt        DateTime?

  provider           String?
  providerCustomerId String?
  providerSubId      String?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  events       SubscriptionEvent[]
  invoices     Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, status])
}

model SubscriptionEvent {
  id             String                   @id @default(cuid())
  subscriptionId String
  actorUserId    String?
  action         SubscriptionEventAction
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus?
  fromPlanId     String?
  toPlanId       String?
  note           String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  fromPlan     Plan?        @relation("SubscriptionEventFromPlan", fields: [fromPlanId], references: [id], onDelete: SetNull)
  toPlan       Plan?        @relation("SubscriptionEventToPlan", fields: [toPlanId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([subscriptionId, createdAt])
  @@index([actorUserId])
}

model Invoice {
  id               String        @id @default(cuid())
  organizationId   String
  subscriptionId   String?
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("INR")
  status           InvoiceStatus @default(DUE)
  periodStart      DateTime?
  periodEnd        DateTime?
  paymentReference String?
  issuedAt         DateTime      @default(now())
  paidAt           DateTime?
  createdByUserId  String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([subscriptionId])
  @@index([createdByUserId])
}

model PlatformAuditLog {
  id          String  @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  description String?
  metadata    Json?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  reservationId String?
  title         String
  message       String
  type          String    @default("GENERAL")
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([reservationId])
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   @default("ANDROID")
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model ApiKey {
  id             String   @id @default(cuid())
  organizationId String
  createdByUserId String

  name       String
  keyHash    String   @unique
  keyPrefix  String
  scopes     String[] @default([])

  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt])
  @@index([createdByUserId])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model OutboundMessage {
  id              String         @id @default(cuid())
  organizationId  String
  restaurantId    String?
  reservationId   String?
  createdByUserId String?
  channel         MessageChannel
  toPhone         String
  body            String
  status          String         @default("DISPATCHED")
  createdAt       DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("OutboundMessageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, channel, createdAt])
  @@index([createdByUserId])
}
