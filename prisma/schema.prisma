generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  SEATED
  COMPLETED
  NO_SHOW
}

enum SeatingPreference {
  ANY
  FAMILY
  NON_FAMILY
}

enum CoolingPreference {
  ANY
  AC
  NON_AC
}

enum ReservationSource {
  PUBLIC_WEB
  CUSTOMER_APP
  ADMIN_APP
  PHONE
  WALK_IN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  phone         String?
  status        UserStatus     @default(ACTIVE)
  notifications Notification[]
  deviceTokens  DeviceToken[]

  memberships OrganizationMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Organization {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  memberships  OrganizationMember[]
  branches     Branch[]
  subscription Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(STAFF)
  isActive       Boolean          @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Branch {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String  @default("India")
  postalCode     String?
  phone          String?
  timezone       String  @default("Asia/Kolkata")
  isActive       Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, isActive])
}

model Restaurant {
  id            String  @id @default(cuid())
  branchId      String  @unique
  name          String
  slug          String  @unique
  description   String?
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  area          String?
  city          String?
  state         String?
  country       String  @default("India")
  postalCode    String?
  logoUrl       String?
  coverImageUrl String?
  isPublished   Boolean @default(false)
  isActive      Boolean @default(true)

  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openingHours OpeningHour[]
  tables       RestaurantTable[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, isPublished, isActive])
}

model OpeningHour {
  id           String  @id @default(cuid())
  restaurantId String
  dayOfWeek    Int
  openTime     String?
  closeTime    String?
  isClosed     Boolean @default(false)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, dayOfWeek])
}

model RestaurantTable {
  id               String  @id @default(cuid())
  restaurantId     String
  floorNumber      Int     @default(1)
  roomName         String?
  tableNumber      Int
  seats            Int
  isAc             Boolean @default(false)
  isFamilyFriendly Boolean @default(false)
  isActive         Boolean @default(true)

  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations ReservationTable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId, isActive])
}

model Customer {
  id            String  @id @default(cuid())
  name          String?
  phone         String
  email         String?
  phoneVerified Boolean @default(false)

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([email])
}

model Reservation {
  id          String @id @default(cuid())
  bookingCode String @unique

  restaurantId String
  customerId   String?

  guestName  String
  guestPhone String
  guestEmail String?

  startsAt   DateTime
  endsAt     DateTime
  guestCount Int

  seatingPreference SeatingPreference @default(ANY)
  coolingPreference CoolingPreference @default(ANY)

  status          ReservationStatus @default(PENDING)
  source          ReservationSource @default(PUBLIC_WEB)
  specialRequests String?

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tables     ReservationTable[]
  events     ReservationEvent[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@index([restaurantId, startsAt, status])
  @@index([customerId, startsAt])
  @@index([guestPhone, startsAt])
}

model ReservationTable {
  reservationId String
  tableId       String

  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@id([reservationId, tableId])
  @@index([tableId])
}

model ReservationEvent {
  id            String  @id @default(cuid())
  reservationId String
  eventType     String
  description   String?
  actorUserId   String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reservationId, createdAt])
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  monthlyPrice Decimal  @db.Decimal(10, 2)
  annualPrice  Decimal? @db.Decimal(10, 2)
  currency     String   @default("INR")
  isActive     Boolean  @default(true)

  subscriptions Subscription[]
  entitlements  PlanEntitlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanEntitlement {
  id     String @id @default(cuid())
  planId String
  key    String
  value  Json

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, key])
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  planId         String
  status         SubscriptionStatus @default(TRIALING)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelledAt        DateTime?

  provider           String?
  providerCustomerId String?
  providerSubId      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, status])
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  reservationId String?
  title         String
  message       String
  type          String    @default("GENERAL")
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([reservationId])
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   @default("ANDROID")
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}
